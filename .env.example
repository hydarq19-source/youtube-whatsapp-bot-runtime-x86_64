# ضع رقم هاتف واتساب بصيغة دولية، مثل 15551234567، من دون علامات الاقتباس.
WHATSAPP_PHONE_NUMBER=

# اختياري: مسار ملف YouTube Cookies بصيغة Netscape (cookies.txt).
# صدّره من متصفح مسجل الدخول، واحفظه خارج المستودع بصلاحيات مقيدة.
# YOUTUBE_COOKIES_FILE=/secure/path/youtube-cookies.txt

# هدف استخدام CPU المطبّع على حصة الحاوية. النطاق 1-100، الافتراضي 55.
CPU_EMA_TARGET_PERCENT=55

# وزن عينة CPU الجديدة في EMA (0.05-0.8). الافتراضي 0.25.
CPU_EMA_ALPHA=0.25

# الحد الأقصى لمعدل تنزيل الفيديو؛ الافتراضي 3 MiB/s لتخفيف حمل CPU.
# قلله مثلًا إلى 1.5 إذا استمر الضغط، أو ارفعه إذا كانت الموارد تسمح.
YOUTUBE_DOWNLOAD_LIMIT_MIB_S=3

# أقصى حجم وسيط مشفر يُحفظ في RAM (MB). الافتراضي 512؛ البوت يستخدم كذلك ربع الذاكرة المتاحة كحد أقصى.
# إذا تجاوز الملف الحد أو كانت الذاكرة المتاحة قليلة، يستخدم البوت ملفًا مؤقتًا على القرص.
UPLOAD_MEMORY_MAX_MB=512

# الافتراضي warn (تحذيرات وأخطاء فقط). استخدم info لإظهار التفاصيل أثناء التشخيص.
RUST_LOG=warn
